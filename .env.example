# Special Minds Academy — environment variables.
# Copy to .env.local for local work. On Hostinger, enter the live values in
# hPanel yourself; never commit them or paste them into chat.

# --- Supabase: the Special Minds UAE project's PUBLIC values -----------------
# The academy uses only what anonymous visitors can already do there:
# inserts into ibt_registrations and leads, the IBT payment RPCs and
# ibt_verify_certificate. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Ziina (IBT checkout) -----------------------------------------------------
# Payments are marked paid by specialminds.ae's existing Ziina webhook, which
# updates the same database. No webhook secret is needed here.
ZIINA_API_KEY=

# --- Analytics ----------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
# Google Ads account AW-18369062261 and its four IBT conversion labels.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADS_LABEL_IBT_DEPOSIT=
NEXT_PUBLIC_ADS_LABEL_IBT_PURCHASE=
NEXT_PUBLIC_ADS_LABEL_IBT_LEAD=
NEXT_PUBLIC_ADS_LABEL_IBT_BEGIN_CHECKOUT=
# Microsoft Clarity, if used.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Bigin CRM (optional) -----------------------------------------------------
# Set these to send each IBT registration to Bigin as specialminds.ae does.
# Left empty, the sync is skipped and the checkout works the same.
BIGIN_CLIENT_ID=
BIGIN_CLIENT_SECRET=
BIGIN_REFRESH_TOKEN=
BIGIN_REGION=com

# --- Previews only ------------------------------------------------------------
# On a preview with a placeholder database, forms stop short of saving or
# opening a checkout and say so. NEVER set this on the live site.
# CONTACT_FORM_PREVIEW_MODE=1
